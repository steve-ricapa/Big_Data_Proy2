# Plantilla únicamente: copiar a .env y completar localmente.
# No contiene credenciales reales. No subir .env a Git.

# Google Cloud: usar ADC o identidad de carga; nunca incluir claves en el repositorio.
GCP_PROJECT_ID=
GCP_REGION=
GCP_BILLING_BUDGET_PEN=1000
GCS_RAW_BUCKET=

# Datos
NVD_RAW_DIR=data/raw/nvd

# MongoDB (motor original)
MONGODB_URI=
MONGODB_DATABASE=threat_intelligence

# Apache Cassandra (motor original)
CASSANDRA_CONTACT_POINTS=
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=threat_intelligence
CASSANDRA_LOCAL_DATACENTER=
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# Neo4j (motor original)
NEO4J_URI=
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Runtime recomendado Airflow3.4/LocalExecutor/Postgres en overlay; secretos *_FILE.
AIRFLOW_HOME=
AIRFLOW__CORE__DAGS_FOLDER=
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=
AIRFLOW__CORE__FERNET_KEY=

# API para dashboard/MCP local fuera de Docker (Compose usa http://api:8000).
API_URL=http://127.0.0.1:18000

# MCP remoto: variables reservadas, NO utilizadas por el stdio actual.
# No configuran por sí mismas transporte/autenticación HTTP ni Cloud Run.
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_TRANSPORT=stdio
MCP_AUTH_TOKEN=

# Opcionales CLI fuera de Docker; Compose proporciona paths de secretos.
STAGING_DIR=data/staging
STATE_DIR=data/processed
BATCH_SIZE=200
# Dentro Docker STATE_DIR apunta al volumen checkpoint_data.
