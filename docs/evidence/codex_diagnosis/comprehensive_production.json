              }
            },
            "required": [
              "cve_id"
            ],
            "title": "CVERecord",
            "type": "object"
          },
          "CVSSRecord": {
            "additionalProperties": true,
            "properties": {
              "version": {
                "title": "Version",
                "type": "string"
              },
              "score": {
                "title": "Score",
                "type": "number"
              },
              "severity": {
                "title": "Severity",
                "type": "string"
              },
              "vector": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Vector"
              },
              "source": {
                "anyOf": [
                  {
                    "type": "string"
