    "get_affected_products": {
      "name": "get_affected_products",
      "description": "Affected products/CPEs for an exact CVE; without cve_id return the snapshot's top products.\n\n    CPE associations are source data, not proof that a particular asset is vulnerable.\n    No ID defaults to ranking20 (not the full catalog). mode=catalog enables\n    stable cve_count DESC/id ASC pagination, page_size<=100. page/page_size are\n    only valid for the global catalog. A cve_id selects the existing per-CVE mode.\n    CPE constraints retain version bounds and logical context. view=summary omits\n    CPEs unless include_cpes=true. No unsupported limit argument is accepted.\n    ",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cve_id": {
            "anyOf": [
              {
                "pattern": "^CVE-\\d{4}-\\d{4,19}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cve Id"
          },
          "mode": {
            "default": "ranking",
            "enum": [
              "ranking",
              "catalog"
            ],
            "title": "Mode",
            "type": "string"
          },
          "page": {
            "anyOf": [
              {
                "maximum": 10000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "maxLength": 16,
                "pattern": "^0*(?:[1-9][0-9]{0,3}|10000)$",
                "type": "string"
              }
            ],
            "default": 1,
            "description": "Integer or bounded ASCII digit string (compatibility coercion); boolean/floating input is rejected.",
            "title": "Page"
          },
          "page_size": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 100,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "maxLength": 16,
                    "pattern": "^0*(?:[1-9][0-9]?|100)$",
                    "type": "string"
                  }
                ],
                "description": "Integer or bounded ASCII digit string (compatibility coercion); boolean/floating input is rejected."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page Size"
