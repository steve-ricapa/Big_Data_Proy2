[Unit]
Description=Threat Intelligence academic cloud containers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/ti-data

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/threat-intelligence
ExecStart=/bin/bash /opt/threat-intelligence/scripts/cloud_compose.sh up -d mongodb cassandra neo4j airflow3-postgres api dashboard airflow3-api airflow3-scheduler airflow3-dag-processor keycloak-db keycloak mcp-remote caddy
ExecStop=/bin/bash /opt/threat-intelligence/scripts/cloud_compose.sh stop --timeout 120 mongodb cassandra neo4j airflow3-postgres api dashboard airflow3-api airflow3-scheduler airflow3-dag-processor keycloak-db keycloak mcp-remote caddy
TimeoutStartSec=600
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
