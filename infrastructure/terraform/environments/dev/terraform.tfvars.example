project_id = "REEMPLAZAR-PROYECTO"
region     = "us-central1"
zone       = "us-central1-a"
prefix     = "ti-dev"
# Sustituir por un nombre exacto existente tras consultar catálogo, no usar familia.
boot_image = "projects/debian-cloud/global/images/REEMPLAZAR-IMAGEN-DEBIAN-12"
machine_type = "e2-standard-4"
boot_disk_gb = 30
data_disk_gb = 100
disk_type    = "pd-balanced"
# Requiere aprobación: sin IP, bootstrap no puede acceder a apt ni Docker Hub.
allow_external_egress_ip = false
deletion_protection     = true
notification_channels   = []
web_services            = {}
